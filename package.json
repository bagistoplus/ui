{
  "name": "@bagistoplus/ui",
  "version": "0.0.0",
  "description": "Headless custom elements built on Zag. No shadow DOM, no framework.",
  "license": "MIT",
  "type": "module",
  "sideEffects": true,
  "files": [
    "dist",
    "ui.css"
  ],
  "exports": {
    "./accordion": {
      "types": "./dist/accordion/index.d.ts",
      "default": "./dist/accordion/index.js"
    },
    "./popover": {
      "types": "./dist/popover/index.d.ts",
      "default": "./dist/popover/index.js"
    },
    "./tabs": {
      "types": "./dist/tabs/index.d.ts",
      "default": "./dist/tabs/index.js"
    },
    "./ui.css": "./ui.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "npm run docs:dev",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zag-js/accordion": "^1.43.3",
    "@zag-js/popover": "^1.43.3",
    "@zag-js/presence": "^1.43.3",
    "@zag-js/tabs": "^1.43.3",
    "@zag-js/types": "^1.43.3",
    "@zag-js/vanilla": "^1.43.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.4",
    "@vitest/browser-playwright": "^5.0.0",
    "playwright": "^1.50.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitepress": "^2.0.0-alpha.17",
    "vitest": "^5.0.0",
    "vue": "^3.5.42"
  }
}
