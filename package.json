{
  "name": "@bagistoplus/ui",
  "version": "0.0.0",
  "description": "Headless custom elements built on Zag. No shadow DOM, no framework.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bagistoplus/ui.git"
  },
  "homepage": "https://github.com/bagistoplus/ui#readme",
  "bugs": {
    "url": "https://github.com/bagistoplus/ui/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": true,
  "files": [
    "src",
    "!src/**/*.test.ts",
    "ui.css",
    "tsconfig.json"
  ],
  "exports": {
    "./accordion": "./src/accordion/index.ts",
    "./before-after": "./src/before-after/index.ts",
    "./carousel": "./src/carousel/index.ts",
    "./date-picker": "./src/date-picker/index.ts",
    "./dialog": "./src/dialog/index.ts",
    "./image-zoom": "./src/image-zoom/index.ts",
    "./marquee": "./src/marquee/index.ts",
    "./menu": "./src/menu/index.ts",
    "./navigation-menu": "./src/navigation-menu/index.ts",
    "./number-input": "./src/number-input/index.ts",
    "./popover": "./src/popover/index.ts",
    "./slider": "./src/slider/index.ts",
    "./tabs": "./src/tabs/index.ts",
    "./timer": "./src/timer/index.ts",
    "./ui.css": "./ui.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "npm run docs:dev",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zag-js/accordion": "^1.43.3",
    "@zag-js/anatomy": "^1.43.3",
    "@zag-js/carousel": "^1.43.3",
    "@zag-js/core": "^1.43.3",
    "@zag-js/date-picker": "^1.43.3",
    "@zag-js/dialog": "^1.43.3",
    "@zag-js/dom-query": "^1.43.3",
    "@zag-js/marquee": "^1.43.3",
    "@zag-js/menu": "^1.43.3",
    "@zag-js/navigation-menu": "^1.43.3",
    "@zag-js/number-input": "^1.43.3",
    "@zag-js/popover": "^1.43.3",
    "@zag-js/presence": "^1.43.3",
    "@zag-js/slider": "^1.43.3",
    "@zag-js/tabs": "^1.43.3",
    "@zag-js/timer": "^1.43.3",
    "@zag-js/types": "^1.43.3",
    "@zag-js/vanilla": "^1.43.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.4",
    "@vitest/browser-playwright": "^5.0.0",
    "playwright": "^1.50.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitepress": "^2.0.0-alpha.17",
    "vitest": "^5.0.0",
    "vue": "^3.5.42"
  }
}
